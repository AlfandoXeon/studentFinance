; Script generated by Antigravity for Student Finance
; Inno Setup 6 Script (.iss)
; Application: Student Finance
; Developer: AlfandoXeon (https://alfandoxeon.freedev.app)

#define MyAppName "Student Finance"
#define MyAppVersion "0.1.0"
#define MyAppPublisher "AlfandoXeon"
#define MyAppURL "https://alfandoxeon.freedev.app"
#define MyAppExeName "Student Finance.exe"
#define MyAppAssocName MyAppName + " Data"
#define MyAppIcon "icon\app_icon.ico"

[Setup]
; App Identity
AppId={{C47265B8-22D9-4BC9-9A83-F124EE01683B}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName} v{#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}

; Installation Target
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
AllowNoIcons=yes

; Output Configuration
OutputDir=dist_installer
OutputBaseFilename=StudentFinance_v{#MyAppVersion}_Setup
SetupIconFile={#MyAppIcon}
UninstallDisplayIcon={app}\{#MyAppExeName}

; Compression & Modern Installer
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern

; Privileges: allows both standard user (Local AppData) and administrator (Program Files)
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline dialog
ArchitecturesInstallIn64BitMode=x64compatible

[Languages]
Name: "indonesian"; MessagesFile: "compiler:Languages\Indonesian.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Dist folder generated by PyInstaller (--onedir)
Source: "dist\{#MyAppName}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "*.db,*.db-wal,*.db-shm,backups\*,logs\*"
Source: "{#MyAppIcon}"; DestDir: "{app}\icon"; Flags: ignoreversion
Source: "icon\icon.png"; DestDir: "{app}\icon"; Flags: ignoreversion

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\icon\app_icon.ico"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\icon\app_icon.ico"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
